{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevora.invalid/contracts/2.0.0-rc2/tool_result",
  "title": "tool_result",
  "$comment": "JSON Schema does not confer Host authority; UTF8 byte limits are additionally enforced by transport.",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ERROR"
        },
        "code": {
          "enum": [
            "INVALID_INPUT",
            "CONTEXT_CONFLICT",
            "UNAUTHORIZED",
            "REVOKED",
            "GRAPH_UNAVAILABLE",
            "GRAPH_CHANGED",
            "STALE_SNAPSHOT",
            "GRAPH_INTEGRITY_ERROR",
            "CAPACITY_EXCEEDED",
            "CURSOR_INVALID_OR_EXPIRED",
            "UNSUPPORTED_PROFILE"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "contract_version": {
          "const": "aevora.mcp/2.0.0-rc2"
        }
      },
      "required": [
        "status",
        "code",
        "retryable",
        "message",
        "contract_version"
      ],
      "additionalProperties": false
    },
    "ResolveResult": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "EMPTY"
          ]
        },
        "contract_version": {
          "const": "aevora.mcp/2.0.0-rc2"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "semantic_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "authz_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "experience_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
              },
              "recommendation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
              },
              "core_verdict": {
                "enum": [
                  "APPLY",
                  "VERIFY",
                  "ABSTAIN"
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
                },
                "maxItems": 32,
                "minItems": 1
              },
              "full_document_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "truncated": {
                "const": true
              },
              "detail_reference": {
                "type": "object",
                "properties": {
                  "tool": {
                    "const": "build_evidence_bundle"
                  },
                  "experience_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
                  },
                  "query_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
                  },
                  "view": {
                    "const": "recommendation"
                  }
                },
                "required": [
                  "tool",
                  "experience_id",
                  "query_id",
                  "view"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "experience_id",
              "recommendation_id",
              "core_verdict",
              "reason_codes",
              "full_document_sha256",
              "truncated",
              "detail_reference"
            ],
            "additionalProperties": false
          },
          "maxItems": 256,
          "minItems": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "contract_version",
        "query_id",
        "semantic_epoch",
        "authz_epoch",
        "candidate_count",
        "candidates",
        "has_more",
        "next_cursor",
        "truncated"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "EMPTY"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_count": {
                "const": 0
              },
              "candidates": {
                "maxItems": 0
              },
              "has_more": {
                "const": false
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Page": {
      "type": "object",
      "properties": {
        "status": {
          "const": "AVAILABLE"
        },
        "contract_version": {
          "const": "aevora.mcp/2.0.0-rc2"
        },
        "projection": {
          "const": "LOSSLESS_JSON_POINTER_ENTRIES"
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "authz_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total_items": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "pointer": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "value": {}
                },
                "required": [
                  "pointer",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "pointer": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "container": {
                    "enum": [
                      "object",
                      "array"
                    ]
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "pointer",
                  "container",
                  "length"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "pointer": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "string_offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "string_length": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 512
                  }
                },
                "required": [
                  "pointer",
                  "string_offset",
                  "string_length",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 512,
          "minItems": 1
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "truncated": {
          "const": true
        }
      },
      "required": [
        "status",
        "contract_version",
        "projection",
        "document_sha256",
        "semantic_epoch",
        "authz_epoch",
        "offset",
        "total_items",
        "entries",
        "has_more",
        "next_cursor",
        "truncated"
      ],
      "additionalProperties": false
    },
    "Complete": {
      "type": "object",
      "properties": {
        "status": {
          "const": "AVAILABLE"
        },
        "contract_version": {
          "const": "aevora.mcp/2.0.0-rc2"
        },
        "projection": {
          "const": "COMPLETE_DOCUMENT"
        },
        "view": {
          "enum": [
            "bundle",
            "candidate",
            "recommendation"
          ]
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document": {
          "type": "object"
        },
        "semantic_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "authz_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "const": false
        },
        "next_cursor": {
          "type": "null"
        },
        "truncated": {
          "const": false
        }
      },
      "required": [
        "status",
        "contract_version",
        "projection",
        "view",
        "document_sha256",
        "document",
        "semantic_epoch",
        "authz_epoch",
        "has_more",
        "next_cursor",
        "truncated"
      ],
      "additionalProperties": false
    },
    "DecisionResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "RECORDED_UNTRUSTED"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "recommendation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trusted_outcome": {
          "const": "NOT_SUBMITTED"
        }
      },
      "required": [
        "status",
        "decision_id",
        "query_id",
        "recommendation_id",
        "payload_sha256",
        "trusted_outcome"
      ],
      "additionalProperties": false
    },
    "ProposalResult": {
      "type": "object",
      "properties": {
        "status": {
          "const": "PROPOSED_UNTRUSTED"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication": {
          "const": "NOT_PUBLISHED"
        },
        "source_type": {
          "const": "UNVERIFIED"
        }
      },
      "required": [
        "status",
        "candidate_id",
        "body_sha256",
        "publication",
        "source_type"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/ResolveResult"
    },
    {
      "$ref": "#/$defs/Page"
    },
    {
      "$ref": "#/$defs/Complete"
    },
    {
      "$ref": "#/$defs/DecisionResult"
    },
    {
      "$ref": "#/$defs/ProposalResult"
    }
  ]
}
