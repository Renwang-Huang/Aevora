{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevora.invalid/contracts/2.0.0-rc2/fact",
  "title": "fact",
  "$comment": "JSON Schema does not confer Host authority; UTF8 byte limits are additionally enforced by transport.",
  "$defs": {
    "RegisteredFactValueTypes": {
      "description": "Host registration registry; values only known with independent source. Strings are public labels, not parsable repair instructions.",
      "type": "object",
      "properties": {
        "task.concurrency_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.worker_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "task.shared_state_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.operation_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.authority_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.clock_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.failure_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.lease_expiry_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.supported_operation_set": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.transaction_guarantees": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.synchronization_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifact_before.authority_validation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifact_after.authority_validation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evaluation.test_suite_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.worker_count_known": {
          "type": "boolean"
        },
        "task.observed_failure_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.shared_object_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "task.sqlite_journal_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "key": {
      "enum": [
        "task.concurrency_scope",
        "task.worker_count",
        "task.shared_state_kind",
        "task.operation_semantics",
        "task.authority_model",
        "task.clock_domain",
        "task.failure_domain",
        "task.contract_version",
        "task.lease_expiry_semantics",
        "task.supported_operation_set",
        "task.transaction_guarantees",
        "task.synchronization_scope",
        "artifact_before.authority_validation",
        "artifact_after.authority_validation",
        "evaluation.test_suite_fingerprint",
        "task.worker_count_known",
        "task.observed_failure_mode",
        "task.shared_object_scope",
        "task.sqlite_journal_mode"
      ]
    },
    "phase": {
      "enum": [
        "task",
        "artifact_before",
        "artifact_after",
        "evaluation"
      ]
    },
    "availability": {
      "enum": [
        "MISSING",
        "UNKNOWN",
        "NOT_OBSERVED",
        "KNOWN"
      ]
    },
    "value": {
      "type": [
        "string",
        "integer",
        "number",
        "boolean",
        "null"
      ]
    },
    "authority_class": {
      "enum": [
        "HOST_DECLARED_TASK",
        "HOST_OBSERVED",
        "INDEPENDENT_ORACLE",
        "UNTRUSTED_AGENT",
        "EXTERNAL_UNVERIFIED",
        null
      ]
    },
    "authority_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$",
            "maxLength": 1024
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_scope": {
            "const": "ARCHIVED_BYTES_INCLUDING_NEWLINE"
          }
        },
        "required": [
          "file",
          "file_sha256",
          "line",
          "line_sha256",
          "byte_scope"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "minItems": 0
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "key",
    "phase",
    "availability",
    "value",
    "authority_class",
    "authority_ref",
    "source_refs",
    "observed_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "authority_class": {
            "enum": [
              "HOST_DECLARED_TASK",
              "HOST_OBSERVED",
              "INDEPENDENT_ORACLE"
            ]
          },
          "authority_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$",
                  "maxLength": 1024
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "byte_scope": {
                  "const": "ARCHIVED_BYTES_INCLUDING_NEWLINE"
                }
              },
              "required": [
                "file",
                "file_sha256",
                "line",
                "line_sha256",
                "byte_scope"
              ],
              "additionalProperties": false
            },
            "maxItems": 32,
            "minItems": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "key": {
            "pattern": "^task\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "artifact_before"
          }
        }
      },
      "then": {
        "properties": {
          "key": {
            "pattern": "^artifact_before\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "artifact_after"
          }
        }
      },
      "then": {
        "properties": {
          "key": {
            "pattern": "^artifact_after\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "evaluation"
          }
        }
      },
      "then": {
        "properties": {
          "key": {
            "pattern": "^evaluation\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "task.concurrency_scope"
          },
          "availability": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "task.worker_count"
          },
          "availability": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "task.shared_state_kind"
          },
          "availability": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    {
      "if": {
        "properties": {
