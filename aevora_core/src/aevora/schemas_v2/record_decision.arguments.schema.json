{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevora.invalid/contracts/2.0.0-rc2/record_decision",
  "title": "record_decision",
  "$comment": "JSON Schema does not confer Host authority; UTF8 byte limits are additionally enforced by transport.",
  "$defs": {},
  "type": "object",
  "properties": {
    "decision": {
      "type": "object",
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "experience_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "recommendation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "decision": {
          "enum": [
            "APPLY",
            "VERIFY",
            "ABSTAIN"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "verification_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 32,
          "minItems": 0
        },
        "action_intent": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "query_id",
        "experience_id",
        "recommendation_id",
        "idempotency_key",
        "decision",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "VERIFY"
              }
            }
          },
          "then": {
            "required": [
              "verification_steps"
            ],
            "properties": {
              "verification_steps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "decision"
  ],
  "additionalProperties": false
}
