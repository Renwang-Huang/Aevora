{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevora.invalid/contracts/2.0.0-rc2/recommendation",
  "title": "recommendation",
  "$comment": "JSON Schema does not confer Host authority; UTF8 byte limits are additionally enforced by transport.",
  "$defs": {},
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "aevora.recommendation/2.0.0-rc2"
    },
    "recommendation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "revision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
      },
      "maxItems": 16,
      "minItems": 0
    },
    "core_verdict": {
      "enum": [
        "APPLY",
        "VERIFY",
        "ABSTAIN"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "policy_version": {
      "const": "aevora.whenwhy/2.0.0-rc2"
    },
    "semantic_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "authz_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "witness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ]
    },
    "required_fact_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "unknown_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
      },
      "maxItems": 64,
      "minItems": 0
    },
    "integrity_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
      },
      "maxItems": 32,
      "minItems": 0
    },
    "contradiction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
      },
      "maxItems": 32,
      "minItems": 0
    },
    "witness_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
      },
      "maxItems": 512,
      "minItems": 0
    },
    "verification_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 32,
      "minItems": 0
    },
    "attribution": {
      "const": "UNKNOWN"
    }
  },
  "required": [
    "contract_version",
    "recommendation_id",
    "query_id",
    "experience_id",
    "revision_ids",
    "core_verdict",
    "reason_codes",
    "policy_version",
    "semantic_epoch",
    "authz_epoch",
    "context_sha256",
    "witness_sha256",
    "completeness",
    "required_fact_count",
    "unknown_required",
    "integrity_issues",
    "contradiction_ids",
    "witness_refs",
    "verification_steps",
    "attribution"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "core_verdict": {
            "const": "APPLY"
          }
        }
      },
      "then": {
        "properties": {
          "completeness": {
            "const": "COMPLETE"
          },
          "unknown_required": {
            "maxItems": 0
          },
          "integrity_issues": {
            "maxItems": 0
          },
          "contradiction_ids": {
            "maxItems": 0
          },
          "witness_refs": {
            "minItems": 1
          },
          "revision_ids": {
            "minItems": 1
          },
          "required_fact_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "core_verdict": {
            "const": "VERIFY"
          }
        }
      },
      "then": {
        "properties": {
          "verification_steps": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
