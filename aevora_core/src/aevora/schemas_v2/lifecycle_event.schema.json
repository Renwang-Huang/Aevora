{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevora.invalid/contracts/2.0.0-rc2/lifecycle_event.schema.json",
  "$comment": "PROPOSED structural contract; only independently authorized Host may instantiate trusted records; schema alone grants no authority.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "aevora.lifecycle/2.0.0-rc2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "from_state": {
      "enum": [
        null,
        "PROPOSED",
        "EVIDENCE_PENDING",
        "ADMITTED_BOUNDED",
        "PUBLISHING",
        "PUBLISHED",
        "REJECTED",
        "WITHDRAWN",
        "SUPERSEDED"
      ]
    },
    "to_state": {
      "enum": [
        "PROPOSED",
        "EVIDENCE_PENDING",
        "ADMITTED_BOUNDED",
        "PUBLISHING",
        "PUBLISHED",
        "REJECTED",
        "WITHDRAWN",
        "SUPERSEDED"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "previous_event_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "semantic_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "contract_version",
    "id",
    "tenant_id",
    "candidate_id",
    "from_state",
    "to_state",
    "sequence",
    "previous_event_id",
    "request_sha256",
    "body_sha256",
    "authority_ref",
    "created_at",
    "semantic_epoch"
  ],
  "additionalProperties": false
}
