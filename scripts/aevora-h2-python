#!/bin/sh
# Trusted H2 launcher: explicit runtime, no personal runtime/config fallback.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${AEVORA_H2_RUNTIME:?Set the separately verified H2 /usr runtime directory}"
: "${AEVORA_FALKORDB_PASSWORD_FILE:?Set an external owner-only project DB password file}"
: "${AEVORA_FALKORDB_PORT:?Set an isolated H2 DB port}"
: "${AEVORA_FALKORDB_GRAPH:?Set an isolated H2 graph}"
case "$AEVORA_FALKORDB_PORT" in 16379) echo 'Refusing H1 database endpoint' >&2; exit 2;; esac
h2_runtime=$(readlink -f -- "$AEVORA_H2_RUNTIME")
[ -x "$h2_runtime/bin/python3.12" ] || { echo 'Expected explicit Python 3.12 runtime' >&2; exit 2; }
h2_password=$(readlink -f -- "$AEVORA_FALKORDB_PASSWORD_FILE")
[ "$h2_password" = "$AEVORA_FALKORDB_PASSWORD_FILE" ] || { echo 'Refusing linked credential' >&2; exit 2; }
[ -f "$h2_password" ] && [ "$(stat -c %u "$h2_password")" = "$(id -u)" ] \
  && [ "$(stat -c %a "$h2_password")" = 600 ] \
  && [ "$(stat -c %h "$h2_password")" = 1 ] || { echo 'Credential must be owner-only ordinary single-link file' >&2; exit 2; }
h2_cgroup=${ORDERFLOW_CGROUP_PARENT:?Set a genuinely delegated cgroup v2 parent}
set -- "$root/.venv/bin/python" "$@"
if [ "${ORDERFLOW_ENABLE_CODEX:-0}" = 1 ]; then
  h2_codex=$(readlink -f "${ORDERFLOW_CODEX_BINARY:-$(command -v codex)}")
  h2_gateway_secret=${ORDERFLOW_GATEWAY_SECRET_PATH:?Set an external owner-only gateway credential}
  [ -f "$h2_gateway_secret" ] && [ ! -L "$h2_gateway_secret" ] \
    && [ "$(stat -c %u "$h2_gateway_secret")" = "$(id -u)" ] \
    && [ "$(stat -c %a "$h2_gateway_secret")" = 600 ] \
    && [ "$(stat -c %h "$h2_gateway_secret")" = 1 ] || { echo 'Gateway credential permissions rejected' >&2; exit 2; }
  set -- --ro-bind "$h2_gateway_secret" /maintainer/gateway.key \
    --setenv ORDERFLOW_GATEWAY_SECRET_PATH /maintainer/gateway.key \
    --setenv ORDERFLOW_GATEWAY_URL "${ORDERFLOW_GATEWAY_URL:-https://api.renwang-huang.top/v1}" \
    --ro-bind "$(dirname "$h2_codex")/codex-code-mode-host" /tools/codex-code-mode-host \
    --ro-bind "$h2_codex" /tools/codex --setenv ORDERFLOW_CODEX_BINARY /tools/codex "$@"
fi
exec bwrap --die-with-parent --unshare-user --unshare-pid \
  --ro-bind "$h2_runtime" /usr \
  --ro-bind /usr/bin/bwrap /tools/bwrap --ro-bind /usr/bin/git /tools/git \
  --ro-bind /etc/resolv.conf /etc/resolv.conf --ro-bind /etc/ssl/certs /etc/ssl/certs \
  --ro-bind "$h2_password" /maintainer/aevora-db.password \
  --bind /sys/fs/cgroup /sys/fs/cgroup \
  --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/bin /bin \
  --proc /proc --dev /dev --tmpfs /tmp \
  --bind "$root" "$root" --chdir "$root" --clearenv \
  --setenv HOME /tmp --setenv PATH "$root/.venv/bin:/tools:/usr/bin" \
  --setenv SSL_CERT_FILE /etc/ssl/certs/ca-certificates.crt \
  --setenv ORDERFLOW_CGROUP_PARENT "$h2_cgroup" \
  --setenv AEVORA_FALKORDB_HOST 127.0.0.1 --setenv AEVORA_FALKORDB_PORT "$AEVORA_FALKORDB_PORT" \
  --setenv AEVORA_FALKORDB_GRAPH "$AEVORA_FALKORDB_GRAPH" \
  --setenv AEVORA_FALKORDB_PASSWORD_FILE /maintainer/aevora-db.password "$@"
