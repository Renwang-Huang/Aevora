{
  "schema_version": "aevora.retrieval-quality/1",
  "provenance": "Hand-labelled synthetic public engineering cases frozen before retrieval changes. Not production utility or applicability proof.",
  "documents": [
    {
      "id": "experience:quality:sqlite-lock",
      "title": "SQLite WAL writer contention",
      "public_summary": "SQLite WAL busy writer transaction locking",
      "strategy": "Keep network calls outside SQLite write transactions and retry busy writes with a bounded budget."
    },
    {
      "id": "experience:quality:dns",
      "title": "DNS NXDOMAIN troubleshooting",
      "public_summary": "DNS domain resolution name not resolved NXDOMAIN",
      "strategy": "Query authoritative DNS and recursive resolvers, then check delegation and stale negative caches."
    },
    {
      "id": "experience:quality:tls",
      "title": "TLS certificate renewal",
      "public_summary": "TLS HTTPS certificate expiry renewal ACME",
      "strategy": "Renew the ACME certificate and verify the certificate served by the reverse proxy before reloading."
    },
    {
      "id": "experience:quality:late-source",
      "title": "Incremental late source ingestion",
      "public_summary": "late arriving source ID cursor ingestion progress",
      "strategy": "Track processed source identities transactionally rather than assuming lexical IDs arrive in order."
    },
    {
      "id": "experience:quality:permission",
      "title": "Service environment permissions",
      "public_summary": "systemd user service DBus runtime directory permission",
      "strategy": "Pass the intended user IPC environment and verify directory ownership rather than granting broad permissions."
    },
    {
      "id": "experience:quality:json",
      "title": "Empty upstream JSON response",
      "public_summary": "JSON decode empty upstream response boundary",
      "strategy": "Inspect HTTP status and content type before JSON parsing; distinguish empty and truncated responses."
    },
    {
      "id": "experience:quality:queue",
      "title": "Session instruction queue",
      "public_summary": "queued instruction session turn completion",
      "strategy": "Queue the next instruction while the active turn runs and dispatch after completion using stable session identity."
    },
    {
      "id": "experience:quality:disk",
      "title": "Read only filesystem writes",
      "public_summary": "read only filesystem disk write ENOSPC",
      "strategy": "Preserve the failed write, check mount state and available storage, then retry after the write path is restored."
    },
    {
      "id": "experience:quality:restart",
      "title": "Host read session recovery",
      "public_summary": "Host restart MCP read session recovery",
      "strategy": "Reconnect the same authorized read session after a normal Host restart and reconcile uncertain writes."
    },
    {
      "id": "experience:quality:pagination",
      "title": "Cursor pagination ordering",
      "public_summary": "cursor pagination stable IDs page ordering",
      "strategy": "Use a stable cursor for bounded UI pages and refresh from the start to include newly inserted lower IDs."
    }
  ],
