  "lifecycle_guidance": {
    "ADMITTED_BOUNDED": {
      "action": "Host publishes with review --state PUBLISHED and the inspected expected head.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "EVIDENCE_PENDING": {
      "action": "Run an independent verifier; import with source-project, then review ADMITTED_BOUNDED using --source and --scope. Self-test PASS is insufficient.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "PROPOSED": {
      "action": "Host inspects the immutable proposal, then reviews it into EVIDENCE_PENDING or REJECTED.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "PUBLISHED": {
      "action": "Query with a new Run and independently known context; inspect the evidence bundle. Adoption and causal benefit remain UNKNOWN.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "PUBLISHING": {
      "action": "Retry review --state PUBLISHED with the current inspected head to finish the same publication, or withdraw.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "REJECTED": {
      "action": "Retain this rejected proposal; submit a corrected proposal with a new candidate key.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "SUPERSEDED": {
      "action": "Retain this history and query the independently published replacement.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    },
    "WITHDRAWN": {
      "action": "This candidate is excluded from recommendations. New evidence requires a new reviewed candidate.",
      "guide": "docs/PROJECT_SOURCES.md",
      "host_only": true
    }
  },
