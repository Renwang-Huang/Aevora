// PROPOSED / NOT_EXECUTED; Host params only; payload/manifest verification is mandatory.
MATCH (s:TenantState {id:$state,tenant_id:$tenant})-[:COMMITS]->(m:PublicationManifest)<-[:PUBLISHED_BY]-(g:GovernanceEvent)-[link:GOVERNS]->(target), (e:Experience {id:$experience,tenant_id:$tenant})-[:HAS_REVISION]->(r:ExperienceRevision) WHERE m.tenant_id=$tenant AND g.tenant_id=$tenant AND target.tenant_id=$tenant AND r.tenant_id=$tenant AND m.epoch<=s.epoch AND (target.id=r.id OR target.id IN $evidence_ids) RETURN DISTINCT g.id,g.payload_json,g.payload_sha256,target.id,link.id,m.id ORDER BY g.id,target.id LIMIT 257
