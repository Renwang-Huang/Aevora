// PROPOSED / NOT_EXECUTED; Host params only; payload/manifest verification is mandatory.
MATCH (s:TenantState {id:$state,tenant_id:$tenant})-[:COMMITS]->(m:PublicationManifest)<-[:PUBLISHED_BY]-(r:ExperienceRevision)<-[:HAS_REVISION]-(e:Experience {id:$experience,tenant_id:$tenant}), (r)-[:USES_RULE]->(rule:Rule)-[:REQUIRES]->(p:Premise) WHERE m.tenant_id=$tenant AND r.tenant_id=$tenant AND rule.tenant_id=$tenant AND p.tenant_id=$tenant AND m.epoch<=s.epoch RETURN r.id,rule.id,p.id,r.payload_json,r.payload_sha256,rule.payload_json,rule.payload_sha256,p.payload_json,p.payload_sha256 ORDER BY r.id,rule.id,p.id LIMIT 1025
