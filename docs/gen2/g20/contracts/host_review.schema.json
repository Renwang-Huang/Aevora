{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevora.invalid/contracts/2.0.0-rc1/host_review",
  "title": "host_review",
  "$comment": "PROPOSED design contract, not an implemented server; JSON Schema does not confer Host authority; UTF8 byte limits are additionally enforced by transport.",
  "$defs": {},
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "aevora.host.review/2.0.0-rc1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "expected_head_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_semantic_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "action": {
      "enum": [
        "EVIDENCE_PENDING",
        "REJECTED",
        "ADMITTED_BOUNDED",
        "PUBLISH",
        "WITHDRAW",
        "SUPERSEDE"
      ]
    },
    "source_verification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+\\-]{0,239}$"
    },
    "review_scope": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "maxItems": 32,
        "minItems": 1
      },
      "propertyNames": {
        "enum": [
          "task.concurrency_scope",
          "task.worker_count",
          "task.shared_state_kind",
          "task.operation_semantics",
          "task.authority_model",
          "task.clock_domain",
          "task.failure_domain",
          "task.contract_version",
          "task.lease_expiry_semantics",
          "task.supported_operation_set",
          "task.transaction_guarantees",
          "task.synchronization_scope",
          "artifact_before.authority_validation",
          "artifact_after.authority_validation",
          "evaluation.test_suite_fingerprint"
        ]
      },
      "maxProperties": 32,
      "minProperties": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "strength": {
      "const": "BOUNDED_SUPPORT_NOT_CAUSAL"
    }
  },
  "required": [
    "contract_version",
    "candidate_id",
    "expected_head_sha256",
    "expected_semantic_epoch",
    "idempotency_key",
    "action",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "ADMITTED_BOUNDED",
              "PUBLISH"
            ]
          }
        }
      },
      "then": {
        "required": [
          "source_verification_id",
          "review_scope",
          "strength"
        ]
      }
    }
  ]
}
