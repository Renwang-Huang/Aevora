    {
      "name": "propose_experience",
      "title": null,
      "description": "Propose UNTRUSTED conditional experience, never publish or verify it.\n\n            Required exact fields: candidate_key (short local ID), title,\n            strategy, public_summary; necessary_conditions, inapplicable_conditions\n            and scope (public fact keys mapped to lists of scalar values);\n            unknown_fields (public fact NAMES only), limitations (free-text lists); source_references (list of\n            {kind: Query|Decision|ObservedAction, id: actual current-run ID}).\n            Use unknown_fields for unproved premises. No paths, credentials,\n            run_id, source_type, verified, outcome or publication authority.\n            The trusted host independently establishes origin and admission.\n            ",
      "inputSchema": {
        "$defs": {
          "CandidateProposal": {
            "additionalProperties": false,
            "properties": {
              "candidate_key": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+\\-]{0,63}$",
                "title": "Candidate Key",
                "type": "string"
              },
              "title": {
                "maxLength": 4000,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "strategy": {
                "description": "Observed engineering principle as untrusted narrative",
                "maxLength": 4000,
                "minLength": 1,
                "title": "Strategy",
                "type": "string"
              },
              "public_summary": {
                "maxLength": 4000,
                "minLength": 1,
                "title": "Public Summary",
                "type": "string"
              },
              "necessary_conditions": {
                "additionalProperties": {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array"
                },
                "description": "OBJECT mapping public semantic fact names to allowed scalar ARRAYS; NOT a list of sentences",
                "minProperties": 1,
                "propertyNames": {
                  "enum": [
                    "authority_model",
                    "authority_validation",
                    "clock_domain",
                    "concurrency_scope",
                    "contract_version",
                    "failure_domain",
                    "lease_expiry_semantics",
                    "observed_failure_mode",
                    "operation_semantics",
                    "shared_object_scope",
                    "shared_state_kind",
                    "sqlite_journal_mode",
                    "supported_operation_set",
                    "synchronization_scope",
                    "transaction_guarantees",
                    "worker_count",
                    "worker_count_known"
                  ]
                },
                "title": "Necessary Conditions",
                "type": "object"
              },
              "inapplicable_conditions": {
                "additionalProperties": {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array"
                },
                "description": "OBJECT of factual exclusion conditions. Empty object if none established; narrative limitations belong in limitations",
                "propertyNames": {
                  "enum": [
                    "authority_model",
                    "authority_validation",
                    "clock_domain",
                    "concurrency_scope",
                    "contract_version",
                    "failure_domain",
                    "lease_expiry_semantics",
                    "observed_failure_mode",
                    "operation_semantics",
                    "shared_object_scope",
                    "shared_state_kind",
                    "sqlite_journal_mode",
                    "supported_operation_set",
                    "synchronization_scope",
                    "transaction_guarantees",
                    "worker_count",
                    "worker_count_known"
                  ]
                },
                "title": "Inapplicable Conditions",
                "type": "object"
              },
              "scope": {
                "additionalProperties": {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array"
                },
                "description": "OBJECT of bounded factual conditions from real context. Do not invent unknown factual values",
                "minProperties": 1,
                "propertyNames": {
                  "enum": [
                    "authority_model",
                    "authority_validation",
                    "clock_domain",
                    "concurrency_scope",
                    "contract_version",
                    "failure_domain",
                    "lease_expiry_semantics",
                    "observed_failure_mode",
                    "operation_semantics",
                    "shared_object_scope",
                    "shared_state_kind",
                    "sqlite_journal_mode",
                    "supported_operation_set",
                    "synchronization_scope",
                    "transaction_guarantees",
                    "worker_count",
                    "worker_count_known"
                  ]
                },
                "title": "Scope",
                "type": "object"
              },
              "unknown_fields": {
                "description": "Public fact NAMES whose values are unproved. Free-text uncertainty goes in limitations. Required unknown premises remain pending",
                "items": {
                  "enum": [
                    "authority_model",
                    "authority_validation",
                    "clock_domain",
                    "concurrency_scope",
                    "contract_version",
                    "failure_domain",
                    "lease_expiry_semantics",
                    "observed_failure_mode",
                    "operation_semantics",
