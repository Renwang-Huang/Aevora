    {
      "name": "build_evidence_bundle",
      "title": null,
      "description": "Show public support, counterexamples and versions for a queried experience.\n\n        Only IDs actually returned by a query in this run are authorized.\n        Hidden tests, reference patches and private report paths are excluded.\n        view=candidate with query_id retrieves the complete immutable resolver\n        decision and bundle. Small responses retain the original shape. Large\n        documents use lossless RFC6901 entries with document_sha256; follow ALL\n        next_cursor pages with the same IDs/view/connection before concluding.\n        Cursors expire after 900 seconds; restart this tool without a cursor if\n        expired/evicted. No outcome or applicability is changed by pagination.\n        ",
      "inputSchema": {
        "properties": {
          "experience_id": {
            "title": "Experience Id",
            "type": "string"
          },
          "query_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query Id"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "view": {
            "default": "bundle",
            "title": "View",
            "type": "string"
          }
        },
        "required": [
          "experience_id"
        ],
        "title": "build_evidence_bundleArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "build_evidence_bundleDictOutput",
        "type": "object"
