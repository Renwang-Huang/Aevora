  "tools": [
    {
      "name": "resolve_experience",
      "title": null,
      "description": "Resolve public applicability facts against actual graph evidence.\n\n        task_context may contain concurrency_scope, worker_count_known,\n        shared_state_kind, synchronization_scope, transaction_guarantees,\n        observed_failure_mode, shared_object_scope, sqlite_journal_mode.\n        worker_count_known is boolean, not a worker count or array. All other\n        fields are text labels or null. Arrays, nested objects and extra fields\n        are invalid. Examples in schema are public vocabulary, not pinned values.\n        Use task_context={} to query without claims. Omit or use null for unknown\n        claims; missing trusted facts remain unknown. Preserve returned query_id.\n        Caller claims are archived but cannot establish applicability premises.\n        Responses contain bounded candidate previews with explicit evidence counts.\n        Follow next_cursor (same task_context and connection) until has_more=false.\n        Retrieve build_evidence_bundle using the candidate's detail_reference for\n        full WHEN/WHY and counterexamples; previews disclose all omitted detail.\n        Cursors expire after 900 seconds and cannot cross SDK connections/runs.\n        ",
      "inputSchema": {
        "properties": {
          "task_context": {
            "additionalProperties": false,
            "description": "Eight documented MCP facts, never a source of trusted applicability.\n\nOmit uncertain claims or use null. Text examples describe public vocabulary,\nnot a closed enum or a particular Run's private/pinned values. The Host's\nexisting extended fact vocabulary remains an internal compatibility contract.\nThe serialized UTF-8 claims object is limited to 8192 bytes before graph\naccess; errors never echo the supplied values.",
            "properties": {
              "concurrency_scope": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Public topology label, e.g. single_process_threads or independent_processes. Omit/null if unknown.",
                "title": "Concurrency Scope"
              },
              "worker_count_known": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Whether the public worker count is known: boolean, NOT a count or [2,4] array. Omit/null if unknown.",
                "title": "Worker Count Known"
              },
              "shared_state_kind": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Public shared-state kind, e.g. sqlite_file. Text label, not a narrative object.",
                "title": "Shared State Kind"
              },
              "synchronization_scope": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Public synchronization scope label, e.g. shared_process_object or per_process.",
                "title": "Synchronization Scope"
              },
              "transaction_guarantees": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Declared public transaction capability label, e.g. sqlite_atomic_write_transactions; not proof of a repair.",
                "title": "Transaction Guarantees"
              },
              "observed_failure_mode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Public failure/symptom label. Missing facts remain unknown; claims cannot establish premises.",
                "title": "Observed Failure Mode"
              },
              "shared_object_scope": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Public shared-object scope label, when independently known. Omit/null otherwise.",
                "title": "Shared Object Scope"
              },
              "sqlite_journal_mode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Observed public SQLite journal-mode label, when known. Omit/null otherwise; no closed enum is imposed.",
                "title": "Sqlite Journal Mode"
              }
            },
            "title": "PublicContextClaims",
            "type": "object"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          }
        },
        "required": [
          "task_context"
        ],
        "title": "resolve_experienceArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "resolve_experienceDictOutput",
        "type": "object"
